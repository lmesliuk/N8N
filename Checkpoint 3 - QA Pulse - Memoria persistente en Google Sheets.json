        "jsCode": "const d = $input.first().json;\nreturn [{ json: {\n  Session_ID: d.Session_ID,\n  Fecha_Actualizacion: new Date().toISOString(),\n  Usuario: d.Usuario || 'Usuario QA',\n  Resumen_Consolidado: d.Resumen_Consolidado,\n  Estado_Caso: d.Estado_Caso || 'en_seguimiento',\n  Datos_Clave: d.Datos_Clave || '[]',\n  Cantidad_Mensajes: d.Cantidad_Mensajes,\n  Buffer_Reciente: d.Buffer_Reciente,\n  output: d.output\n} }];"
      },
