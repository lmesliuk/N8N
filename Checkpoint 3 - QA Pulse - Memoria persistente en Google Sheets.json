    {
      "parameters": {
        "jsCode": "const base = $('Preparar contexto de memoria').first().json;\nconst agent = $input.first().json;\nconst chat = $('When chat message received').first().json;\nconst consulta = String(chat.chatInput || '').slice(0, 600);\nconst respuesta = String(agent.output || agent.text || 'Sin respuesta').slice(0, 1400);\nconst cantidad = Number(base.Cantidad_Mensajes || 0) + 1;\nconst entrada = `Usuario: ${consulta}\\nAgente: ${respuesta}`;\nconst buffer = [base.Buffer_Reciente, entrada].filter(Boolean).join('\\n---\\n').slice(-12000);\n\nreturn [{\n  json: {\n    ...base,\n    output: respuesta,\n    Cantidad_Mensajes: cantidad,\n    Buffer_Reciente: buffer,\n    necesita_resumen: cantidad > 5\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        448
      ],
      "id": "1a83d438-3748-4b58-9385-be8c8ebceab5",
