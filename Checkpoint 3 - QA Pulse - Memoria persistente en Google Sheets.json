      "id": "147206d5-fe2e-43c6-bcb8-567a3bd2b2ac",
      "name": "Preparar guardado sin resumen"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=RESUMEN ANTERIOR\n{{ $json.Resumen_Consolidado }}\n\nINTERCAMBIOS RECIENTES\n{{ $json.Buffer_Reciente }}",
        "options": {
          "systemMessage": "Sos un resumidor económico de memoria para QA Pulse. Condensá únicamente hechos útiles y accionables. No guardes datos personales, credenciales, HTML, logs técnicos ni transcripciones completas. Devolvé EXCLUSIVAMENTE un JSON válido con esta estructura exacta: {\"asunto_principal\":\"string\",\"puntos_clave\":[\"string\"],\"accion_requerida\":\"string\"}. No uses Markdown ni agregues texto fuera del JSON. Si no hay acción requerida, usá \"ninguna\"."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2240,
        352
      ],
      "id": "71e0bb68-c4c1-4cc1-8399-63c783550eaf",
      "name": "AI Agent - Resumidor"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output || '').trim();\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  parsed = {\n    asunto_principal: 'Seguimiento de consultas QA',\n    puntos_clave: [cleaned.slice(0, 800)],\n    accion_requerida: 'revisar resumen manualmente'\n  };\n}\nconst anterior = $('Actualizar contador y buffer').first().json;\nconst puntos = Array.isArray(parsed.puntos_clave) ? parsed.puntos_clave : [];\nconst accion = String(parsed.accion_requerida || 'ninguna');\n\nreturn [{ json: {\n  Session_ID: anterior.Session_ID,\n  Fecha_Actualizacion: new Date().toISOString(),\n  Usuario: anterior.Usuario || 'Usuario QA',\n  Resumen_Consolidado: JSON.stringify({\n    asunto_principal: String(parsed.asunto_principal || 'Seguimiento QA'),\n    puntos_clave: puntos,\n    accion_requerida: accion\n  }),\n  Estado_Caso: accion.toLowerCase() === 'ninguna' ? 'en_seguimiento' : 'requiere_accion',\n  Datos_Clave: JSON.stringify(puntos),\n  Cantidad_Mensajes: 0,\n  Buffer_Reciente: '',\n  output: anterior.output\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        352
      ],
